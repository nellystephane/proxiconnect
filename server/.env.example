# Copiez ce fichier en .env et remplissez les valeurs réelles.
# Ne jamais committer le vrai .env (secrets réels) dans le dépôt.

# ─── Base de données ───
MONGODB_URI=

# ─── Authentification ───
# Chaîne aléatoire longue (ex: openssl rand -base64 48). Obligatoire en production —
# le serveur refuse de démarrer sans cette variable si NODE_ENV=production.
JWT_SECRET=

# ─── CORS ───
# Liste des origines autorisées à appeler l'API, séparées par des virgules.
# Par défaut (si absent) : le front GitHub Pages + localhost en dev.
CORS_ORIGINS=https://nellystephane.github.io,http://localhost:5173

# ─── Webhook de confirmation de paiement ───
# Clé partagée avec le fournisseur Mobile Money pour valider les appels au
# webhook PUT /api/paiements/:id/confirmer (voir paiementController.js).
WEBHOOK_SECRET=

# ─── Divers ───
NODE_ENV=production
PORT=5000
