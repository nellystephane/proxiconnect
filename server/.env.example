# Port du serveur (défaut: 5000)
PORT=5000

# URI de connexion MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/proxiconnect?retryWrites=true&w=majority

# Clé secrète JWT (changez-la en production !)
JWT_SECRET=votre_cle_secrete_tres_longue_et_aleatoire

# Clé secrète pour le webhook de confirmation de paiement (optionnel pour le mode démo)
WEBHOOK_SECRET=votre_cle_webhook_secrete

